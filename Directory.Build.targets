<Project>
  <!-- Jellyfin package line per target framework (pinned, see docs/NOTES.md "Deviazioni dal design"). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <DefineConstants>$(DefineConstants);JF10_11</DefineConstants>
    <JellyfinPackageVersion>10.11.9</JellyfinPackageVersion>
    <PluginTargetAbi>10.11.9.0</PluginTargetAbi>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);JF12</DefineConstants>
    <JellyfinPackageVersion>12.0.0</JellyfinPackageVersion>
    <PluginTargetAbi>12.0.0.0</PluginTargetAbi>
  </PropertyGroup>
</Project>
